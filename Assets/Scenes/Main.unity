  m_Script: {fileID: 11500000, guid: 13f95ce302094664890a5c8a45882766, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Runtime::IntroCutsceneDirector
  actorLeft: {fileID: 1295751836}
  actorRight: {fileID: 1475115200}
  talkStage: {fileID: 0}
  cinematicCamera: {fileID: 1999519790}
  scenicWaypoints: []
  lines:
  - speaker: Liora
    text: "Traveler\u2026 look out over the Iliac Bay. High Rock to the north, Hammerfell
      to the south."
    holdSeconds: 4.2
  - speaker: Kael
    text: "This is only a homage \u2014 a prototype world built to explore that legend."
    holdSeconds: 3.8
  - speaker: Liora
    text: "Daggerfall, Wayrest, Sentinel\u2026 islands of Betony, Balfiera, Cybiades.
      Walk them as you will."
    holdSeconds: 4.5
  - speaker: Kael
    text: No fate is written here yet. Just wind, water, and the road ahead.
    holdSeconds: 3.6
  - speaker: Liora
    text: "Come. Let the bay show itself\u2026 then the path is yours."
    holdSeconds: 3.4
  scenicDuration: 22
  scenicHoldAtEnd: 1.5
