--- !u!114 &1434433678
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1434433677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13f95ce302094664890a5c8a45882766, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Runtime::IntroCutsceneDirector
  actorLeft: {fileID: 935370841}
  actorRight: {fileID: 1109632391}
  talkStage: {fileID: 0}
  cinematicCamera: {fileID: 583102966}
  scenicWaypoints: []
  lines:
  - speaker: Liora
    text: "Traveler\u2026 look out over Ratna Bay. Uttara to the north, Maru to the
      south."
    holdSeconds: 4.2
  - speaker: Kael
    text: "A young coast, and a prototype of one \u2014 early, unfinished, open to
      walk."
    holdSeconds: 3.8
  - speaker: Liora
    text: "Sabhapur, Ratnapur, Marukot\u2026 islands of Kusha, Meru, Shaka. Walk
      them as you will."
    holdSeconds: 4.5
  - speaker: Kael
    text: No fate is written here yet. Just wind, water, and the road ahead.
    holdSeconds: 3.6
  - speaker: Liora
    text: "Come. Let the bay show itself\u2026 then the path is yours."
    holdSeconds: 3.4
  scenicDuration: 22
  scenicHoldAtEnd: 1.5
