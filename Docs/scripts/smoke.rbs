# A scripted playtest.
#
# Run it with:
#     build\RatnaBay.exe --script Docs\scripts\smoke.rbs
#
# A script opens in the yard, because commands act on a world and the menu has
# none. Pass --mine, --moodboard or --stambha to script one of those instead.
#
# Every line is one console statement. Blank lines and # comments are ignored.
# The process exits 1 if any assert fails, so this can gate a build. A command
# nothing registers fails the run before the first statement, rather than
# halfway down with the asserts above it already reported as passing.
#
# 'wait' takes SECONDS of simulated time, not frames. Capture mode runs uncapped,
# so a frame count buys an unpredictable and usually tiny amount of game time --
# which once made a still-rising enemy look like a rendering fault.

echo === the yard ===

# Named geometry rather than 'where has yard' on its own: "the yard" is also what
# 'where' answers when there is no run at all, so that assert passed on the title
# screen -- a green gate for a build that never loaded a world.
assert geo has surface.ground
assert where has yard

# The mouth of the mine has to be a hole you can see down, and the path must not
# be laid across it. Both of those were wrong at once, and neither was visible
# from the spawn point.
goto shaft
look at shaft -0.6
assert pick has shaft
shot captures/script-1-shaft.png

# The fort is a place you walk into, not a panel. It arrived on one branch while
# the client was being split on another, so nothing had ever driven it: the two
# asserts below are the only thing standing between "the gate opens" and a fort
# nobody can reach.
echo === the fort ===

goto fort
look 4.71 0
use
wait 1
assert where has fort
assert geo has fort
shot captures/script-1b-fort.png

# Out past the threshold behind the spawn. Walking out is the only way to leave,
# so a fort you cannot leave is one bad number away at all times.
goto 0 2.4 21
wait 1
assert where has yard

echo === buying in ===

gold 500
stones 40
assert where has yard

echo === a descent ===

descend 3 20789
wait 0.5
assert where has room

# Walk in far enough for the room to notice, then let the bodies finish standing
# up. Asking before they have is how the rise animation gets mistaken for a bug.
noclip on
god on
goto 0 -30
wait 3

assert enemies has Bandit
assert enemies not rising
shot captures/script-2-room.png

echo === clearing it ===

kill all
wait 0.5
assert enemies has clear

echo === back up ===

surface
wait 0.5
assert where has yard

quit
