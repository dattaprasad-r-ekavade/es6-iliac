<?xml version="1.0" encoding="utf-8"?>
<!-- Headings use a bold atlas so large labels stay clean and distinct. -->
<XnaContent xmlns:Font="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="FontDescription">
    <FontName>Segoe UI</FontName>
    <Size>32</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
