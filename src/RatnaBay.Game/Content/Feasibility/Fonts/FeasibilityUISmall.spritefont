<?xml version="1.0" encoding="utf-8"?>
<!-- Small labels are authored at a higher resolution than the original test font. -->
<XnaContent xmlns:Font="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="FontDescription">
    <FontName>Segoe UI</FontName>
    <Size>18</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
